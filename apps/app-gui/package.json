    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.vue"
  },
  "dependencies": {
    "vue": "^2.7.15",
    "vue-awesome": "^4.5.0",
    "vue-js-modal": "2.0.0-rc.3",
    "vue-loading-overlay": "^3.4.3",
    "vue-multiselect": "^2.1.8",
    "vue-toast-notification": "^1.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.4",
    "eslint": "^8.54.0",
